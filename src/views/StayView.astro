---
import PageLayout from '../layouts/PageLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import { getCopy, routePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getCopy(lang);
---

<PageLayout lang={lang} routeKey="stay">
  <section data-reveal class="mx-auto max-w-content px-[clamp(20px,4vw,48px)] py-[clamp(56px,8vw,96px)]">
    <Eyebrow>{t.stay.eyebrow}</Eyebrow>
    <h1
      class="mb-4 mt-3.5 max-w-[16em] font-display text-[clamp(32px,5vw,52px)] font-semibold leading-[1.1] text-ombra-scura"
    >
      {t.stay.title}
    </h1>
    <p class="max-w-[38em] text-[clamp(16.5px,1.6vw,18px)] leading-[1.7] text-ombra [text-wrap:pretty]">
      {t.stay.lead}
    </p>
  </section>

  <section
    data-reveal
    class="mx-auto grid max-w-content gap-[clamp(24px,3vw,32px)] px-[clamp(20px,4vw,48px)] pb-[clamp(56px,8vw,96px)] md:grid-cols-3"
  >
    {
      t.stay.rooms.map((room) => (
        <Card elevation="shadow">
          <h3 class="mb-2.5 font-display text-[23px] font-semibold italic text-ombra-scura">
            {room.title}
          </h3>
          <p class="m-0 text-base leading-[1.7] text-ombra">{room.body}</p>
        </Card>
      ))
    }
  </section>

  <section data-reveal class="bg-muro-chiaro">
    <div
      class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-6 px-[clamp(20px,4vw,48px)] py-[clamp(48px,7vw,72px)]"
    >
      <p class="m-0 max-w-[32em] font-display text-[clamp(21px,2.8vw,26px)] italic text-ombra-scura">
        {t.contact.lead}
      </p>
      <Button as="a" href={routePath(lang, 'contact')} variant="primary" size="lg">
        {t.contact.teaserCta}
      </Button>
    </div>
  </section>
</PageLayout>
