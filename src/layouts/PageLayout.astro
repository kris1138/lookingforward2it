---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Lang, RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  title?: string;
  description?: string;
}
const { lang, routeKey, title, description } = Astro.props;
---

<BaseLayout lang={lang} routeKey={routeKey} title={title} description={description}>
  <div class="min-h-screen bg-muro">
    <Nav lang={lang} current={routeKey} />
    <slot />
    <Footer lang={lang} />
  </div>
</BaseLayout>
