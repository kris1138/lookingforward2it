---
import Wordmark from './Wordmark.astro';
import { routePath, getCopy, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Drop the top margin to a 1px seam, for pages that end on a section already in the footer's colour. */
  flush?: boolean;
}
const { lang, flush = false } = Astro.props;
const t = getCopy(lang);

const visitLinks = [
  { label: t.nav.stay, href: routePath(lang, 'stay') },
  { label: t.nav.story, href: routePath(lang, 'story') },
  { label: t.nav.contact, href: routePath(lang, 'contact') },
];

const findUsLines = t.footer.findUs.split('\n');
---

<footer class:list={[flush ? 'mt-px' : 'mt-24', 'bg-ombra-scura text-muro [--focus-outline:var(--focus-ring)]']}>
  <div
    class="mx-auto grid max-w-content gap-10 px-[clamp(20px,4vw,48px)] py-16 md:grid-cols-[1.4fr_1fr_1fr]"
  >
    <div>
      <Wordmark color="muro" size="lg" href={routePath(lang, 'home')} />
      <p class="mt-4 max-w-[300px] font-body text-[15px] leading-[1.65] text-muro/80">
        {t.footer.blurb}
      </p>
    </div>
    <div>
      <div class="mb-3.5 font-body text-[11px] font-bold uppercase tracking-[0.12em] text-grano">
        {t.footer.visitHeading}
      </div>
      {
        visitLinks.map((link) => (
          <div class="mb-2.5">
            <a href={link.href} class="font-body text-sm text-muro/85 decoration-transparent hover:text-muro hover:decoration-terra active:text-muro active:decoration-terra">
              {link.label}
            </a>
          </div>
        ))
      }
    </div>
    <div>
      <div class="mb-3.5 font-body text-[11px] font-bold uppercase tracking-[0.12em] text-grano">
        {t.footer.findUsHeading}
      </div>
      <p class="m-0 font-body text-sm leading-[1.7] text-muro/85">
        {
          findUsLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </p>
    </div>
  </div>
  <div class="border-t border-muro/15">
    <div
      class="mx-auto flex max-w-content flex-wrap justify-between gap-x-6 gap-y-2 px-[clamp(20px,4vw,48px)] py-[22px] font-body text-xs text-muro/70"
    >
      <span>&copy; 2026 &middot; lookingforward2.it</span>
      <span class="font-display text-[15px] italic text-muro/70">{t.footer.note}</span>
    </div>
  </div>
</footer>
