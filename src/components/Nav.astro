---
import Wordmark from './Wordmark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { routePath, getCopy, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  current?: RouteKey;
}
const { lang, current } = Astro.props;
const t = getCopy(lang);

const items: { key: RouteKey | 'films'; label: string; href: string }[] = [
  { key: 'stay', label: t.nav.stay, href: routePath(lang, 'stay') },
  { key: 'story', label: t.nav.story, href: routePath(lang, 'story') },
  { key: 'films', label: t.nav.films, href: `${routePath(lang, 'home')}#films` },
  { key: 'contact', label: t.nav.contact, href: routePath(lang, 'contact') },
];
---

<header class="sticky top-0 z-40 border-b border-muro-scuro bg-muro">
  <div
    class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-x-6 gap-y-2.5 px-[clamp(18px,4vw,48px)] py-[clamp(11px,2.2vw,18px)]"
  >
    <Wordmark href={routePath(lang, 'home')} />
    <nav class="flex flex-wrap items-center gap-x-[clamp(14px,2.8vw,34px)] gap-y-2">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={[
              'border-b-2 pb-[3px] font-body text-xs font-bold uppercase tracking-button no-underline',
              item.key === current
                ? 'border-grano text-terra'
                : 'border-transparent text-ombra',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <LanguageSwitcher lang={lang} current={current ?? 'home'} />
    </nav>
  </div>
</header>
