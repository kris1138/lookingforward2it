---
interface Props {
  color?: 'ombra' | 'muro';
  size?: 'md' | 'lg';
  href?: string;
  class?: string;
}
const { color = 'ombra', size = 'md', href = '/', class: className } = Astro.props;

const colors = { ombra: 'text-ombra', muro: 'text-muro' };
const sizes = { md: 'text-[26px]', lg: 'text-[30px]' };

const classes = [
  'font-display italic font-semibold leading-none no-underline',
  colors[color],
  sizes[size],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes}>Looking&nbsp;Forward&nbsp;2&nbsp;It</a>
