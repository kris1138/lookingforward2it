---
// Routes are locale-prefixed (/en/, /it/), so this page only exists to send
// visitors to the right one. Each locale page itself has the correct
// <html lang> baked in at build time, so there's no "flash of English"
// concern here the way there was with the old client-only toggle — the
// only thing worth preserving is remembering a returning visitor's
// preferred language.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <title>Looking Forward</title>
  </head>
  <body>
    <script>
      try {
        const stored = localStorage.getItem('lf-lang');
        const lang = stored === 'it' ? 'it' : 'en';
        window.location.replace(`/${lang}/`);
      } catch {
        // Safari private mode throws on localStorage access.
        window.location.replace('/en/');
      }
    </script>
    <p><a href="/en/">Continue in English</a> &middot; <a href="/it/">Continua in italiano</a></p>
  </body>
</html>
