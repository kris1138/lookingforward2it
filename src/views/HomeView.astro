---
import PageLayout from '../layouts/PageLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Divider from '../components/ui/Divider.astro';
import FilmTheater from '../components/FilmTheater';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
import { getCopy, routePath, type Lang } from '../i18n/ui';
import { YOUTUBE_SUBSCRIBE_URL } from '../data/films';
import { fetchChannelFilms } from '../data/youtube';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getCopy(lang);
const films = await fetchChannelFilms();
---

<PageLayout lang={lang} routeKey="home" footerFlush>
  <section
    id="top"
    data-reveal
    class="mx-auto flex max-w-content flex-wrap items-end gap-[clamp(36px,5vw,72px)] px-[clamp(20px,4vw,48px)] pt-[clamp(44px,7vw,88px)]"
  >
    <div class="min-w-0 flex-[1.06_1_400px] pb-6">
      <Eyebrow>{t.hero.eyebrow}</Eyebrow>
      <h1
        class="mb-[22px] mt-[18px] font-display text-display font-semibold tracking-snug text-ombra-scura"
      >
        {t.hero.titleA} <em class="font-medium">{t.hero.titleEm}</em>{t.hero.titleB}
      </h1>
      <p class="mb-[34px] max-w-[30em] text-lead leading-[1.65] text-ombra">
        {t.hero.lead}
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <Button
          as="a"
          href={YOUTUBE_SUBSCRIBE_URL}
          target="_blank"
          rel="noopener"
          variant="primary"
          size="lg"
        >
          {t.hero.ctaSubscribe}
        </Button>
        <Button as="a" href="#films" variant="secondary" size="lg">
          {t.hero.ctaWatch}
        </Button>
      </div>
      <p class="mt-[22px] text-sm text-pietra">{t.hero.note}</p>
    </div>
    <div
      class="h-[clamp(320px,46vw,520px)] min-w-0 flex-[0.84_1_300px] overflow-hidden rounded-arch bg-muro-scuro"
    >
      <Image
        src={heroImage}
        alt="The house at golden hour"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <div data-reveal>
    <Divider variant="dot" />
  </div>

  <section data-reveal class="mx-auto max-w-[760px] px-[clamp(20px,4vw,48px)] text-center">
    <Eyebrow>{t.intro.eyebrow}</Eyebrow>
    <p
      class="mt-4 font-display text-quote font-medium italic text-ombra-scura"
    >
      {t.intro.pull}
    </p>
  </section>

  <section
    data-reveal
    class="mx-auto mt-[clamp(56px,8vw,88px)] grid max-w-content gap-[clamp(30px,4vw,56px)] px-[clamp(20px,4vw,48px)] [grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr))]"
  >
    {
      t.cols.map((col) => (
        <div class="border-t border-muro-scuro pt-5">
          <h3 class="mb-2.5 font-display text-h3 font-semibold italic leading-normal text-ombra-scura">
            {col.title}
          </h3>
          <p class="m-0 text-compact text-ombra [text-wrap:pretty]">{col.body}</p>
        </div>
      ))
    }
  </section>

  <section data-reveal class="mx-auto mt-[clamp(76px,11vw,128px)] max-w-content px-[clamp(20px,4vw,48px)]">
    <Eyebrow>{t.story.eyebrow}</Eyebrow>
    <h2
      class="mb-7 mt-3.5 max-w-[15em] font-display text-h2 font-semibold text-ombra-scura"
    >
      {t.story.title}
    </h2>
    <p class="mb-6 max-w-[34em] text-prose text-ombra [text-wrap:pretty]">
      {t.story.paragraphs[0]}
    </p>
    <a href={routePath(lang, 'story')} class="font-body font-bold">
      {t.story.teaserCta} &rarr;
    </a>
  </section>

  <section id="films" data-reveal class="mt-32 border-y border-muro-scuro bg-muro-chiaro py-[clamp(64px,9vw,96px)]">
    <div class="mx-auto max-w-content px-[clamp(20px,4vw,48px)]">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
        <div class="min-w-0 flex-[1_1_320px]">
          <Eyebrow>{t.films.eyebrow}</Eyebrow>
          <h2 class="my-3 font-display text-h2 font-semibold text-ombra-scura">
            {t.films.title}
          </h2>
          <p class="m-0 max-w-[40em] text-[clamp(16px,1.5vw,17px)] leading-[1.65] text-ombra">
            {t.films.lead}
          </p>
        </div>
        <Button as="a" href={YOUTUBE_SUBSCRIBE_URL} target="_blank" rel="noopener" variant="secondary">
          {t.hero.ctaSubscribe}
        </Button>
      </div>
      <FilmTheater client:visible films={films} listLabel={t.films.listLabel} foot={t.films.foot} />
    </div>
  </section>

  <section data-reveal class="bg-ombra-scura text-muro [--focus-outline:var(--focus-ring)]">
    <div class="mx-auto max-w-content px-[clamp(20px,4vw,48px)] py-[clamp(66px,9vw,104px)]">
      <Eyebrow color="grano">{t.contact.eyebrow}</Eyebrow>
      <h2
        class="mb-5 mt-3.5 max-w-[12em] font-display text-h2 font-semibold text-muro"
      >
        {t.contact.title}
      </h2>
      <p class="mb-8 max-w-[32em] text-prose text-muro/82 [text-wrap:pretty]">
        {t.contact.lead}
      </p>
      <Button as="a" href={routePath(lang, 'contact')} variant="primary" size="lg">
        {t.contact.teaserCta}
      </Button>
    </div>
  </section>
</PageLayout>
