---
interface Props {
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
}
const { href = '#', target, rel, class: className } = Astro.props;

const classes = [
  'cursor-pointer text-ombra underline decoration-transparent decoration-1 underline-offset-4 transition-colors duration-brand ease-brand hover:text-ombra-scura hover:decoration-terra active:text-ombra-scura active:decoration-terra',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} target={target} rel={rel} class={classes}><slot /></a>
