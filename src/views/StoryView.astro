---
import PageLayout from '../layouts/PageLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { Image } from 'astro:assets';
import storyImage from '../assets/images/story.jpg';
import { getCopy, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getCopy(lang);
---

<PageLayout lang={lang} routeKey="story">
  <section
    data-reveal
    class="mx-auto flex max-w-content flex-wrap items-start gap-[clamp(40px,6vw,80px)] px-page-pad py-section"
  >
    <div data-story-media class="sticky top-[110px] min-w-0 flex-[0.72_1_280px]">
      <div class="h-[clamp(300px,40vw,460px)] overflow-hidden rounded-soft bg-muro-scuro">
        <Image
          src={storyImage}
          alt={t.story.imageAlt}
          class="h-full w-full object-cover"
        />
      </div>
      <p class="mt-3 text-[13px] text-pietra">{t.story.caption}</p>
    </div>
    <div class="min-w-0 flex-[1_1_380px]">
      <Eyebrow>{t.story.eyebrow}</Eyebrow>
      <h1
        class="mb-7 mt-3.5 max-w-[15em] font-display text-h1 font-semibold text-ombra-scura"
      >
        {t.story.title}
      </h1>
      {
        t.story.paragraphs.map((para) => (
          <p class="mb-6 max-w-[34em] text-prose text-ombra [text-wrap:pretty]">
            {para}
          </p>
        ))
      }
      <div class="mt-12 border-t border-muro-scuro pt-6">
        <Eyebrow>{t.now.eyebrow}</Eyebrow>
        <div class="mt-4 grid gap-4">
          {
            t.now.rows.map((row) => (
              <div class="grid items-baseline gap-x-5 gap-y-2 [grid-template-columns:clamp(96px,22vw,150px)_minmax(0,1fr)]">
                <div class="font-body text-xs font-bold uppercase tracking-label text-terra">
                  {row.when}
                </div>
                <div class="text-[clamp(16px,1.5vw,17px)] leading-[1.6] text-ombra">
                  {row.what}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <script>
    import '../scripts/sticky-story-image';
  </script>
</PageLayout>
