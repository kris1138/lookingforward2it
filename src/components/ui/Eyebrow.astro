---
interface Props {
  color?: 'terra' | 'grano' | 'muro' | 'pietra';
  /** sm = 11px (footer and contact labels), md = 12px; the design system allows 11–12px. */
  size?: 'sm' | 'md';
  as?: 'div' | 'p' | 'span';
  class?: string;
}
const { color = 'terra', size = 'md', as: Tag = 'div', class: className } = Astro.props;

const colors = {
  terra: 'text-terra',
  grano: 'text-grano',
  muro: 'text-muro',
  pietra: 'text-pietra',
};

const sizes = {
  sm: 'text-[11px]',
  md: 'text-label',
};

const classes = [
  'm-0 font-body font-bold uppercase tracking-eyebrow',
  sizes[size],
  colors[color],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes}><slot /></Tag>
